{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Headroom api.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "default_privacy": {
      "enum": [
        "aggregates",
        "consumers",
        "files"
      ]
    },
    "exposed_recipes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "privacy": {
            "enum": [
              "aggregates",
              "consumers",
              "files"
            ]
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allow_scripts": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
