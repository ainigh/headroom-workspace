recipe(
  name = "dev.node_modules_bloat",
  doc = "Largest node_modules trees under a root.",
  params = {"root": param(Path, default = "~/Developer"), "depth": param(int, default = 4, max = 6), "limit": param(int, default = 15, max = 30)},
  tags = ["dev", "disk", "cleanup"],
)

def run(root, depth, limit):
  dirs = fs.find_dirs(root, name = "node_modules", depth = depth) | limit 60
  rows = []
  for d in dirs:
    u = try disk.usage(d.path, depth = 0)
    if count(u) > 0:
      rows.append({"path": d.path, "size": u.size[0]})
  if len(rows) == 0:
    return table([{"path": Path("/"), "size": Bytes(0)}]) | limit 0
  return table(rows) | sort by size desc | limit limit
