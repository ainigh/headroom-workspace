(version 1)
(deny default)
(allow process-fork)
(allow process-exec (literal "__BINARY__"))
(allow file-read*)
(deny file-read* (subpath "__HOME__/.ssh") (subpath "__HOME__/Library/Keychains") (subpath "__HOME__/.gnupg") (subpath "__HOME__/.aws"))
(allow file-write* (literal "/dev/null") (subpath "__SCRATCH__"))
(deny network*)
(allow sysctl-read)
(allow mach-lookup)
(allow iokit-open)
